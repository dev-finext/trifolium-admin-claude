# Where the console reads its records from.
#
#   demo  (default) — the fixture in resources/js/demo/. Fully interactive, no
#                     backend needed. The clock is pinned so relative dates are
#                     stable across loads.
#   api             — the real backend. Set VITE_API_BASE too.
VITE_DATA_SOURCE=demo

# Only read when VITE_DATA_SOURCE=api.
VITE_API_BASE=/api/admin
