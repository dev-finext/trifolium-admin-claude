{
    "name": "trifolium-admin",
    "private": true,
    "type": "module",
    "version": "1.0.0",
    "description": "Trifolium — back-office admin console for a compounding pharmacy. Vue 3 SPA, Hebrew/English, RTL/LTR.",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "check:i18n": "node --import ./scripts/alias-register.mjs scripts/check-i18n.mjs",
        "check:privacy": "node scripts/check-fixture-privacy.mjs",
        "check:build": "node scripts/check-build.mjs",
        "verify": "npm run lint:check && npm run check:i18n && npm run check:privacy && npm run build",
        "verify:prod": "npm run lint:check && npm run check:i18n && npm run check:privacy && npm run build && npm run check:build"
    },
    "engines": {
        "node": ">=20.19"
    },
    "dependencies": {
        "pinia": "^3.0.1",
        "vue": "^3.5.13",
        "vue-i18n": "^11.1.1",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.2",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/eslint-config-typescript": "^14.3.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "tailwindcss": "^4.3.2",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^6.0.11"
    }
}
