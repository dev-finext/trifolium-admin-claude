# Loaded automatically by `vite build`, whose default mode is `production`.
#
# This is the line that keeps the demo fixture out of a production bundle: the
# branch in resources/js/data/source.js folds at compile time, so `api` mode does
# not merely bypass the fabricated records — it removes them from the output.
# `npm run check:build` reads dist/ afterwards and proves it.
VITE_DATA_SOURCE=api
VITE_API_BASE=/api/admin
