# Loaded automatically by `vite` (dev server), whose default mode is `development`.
#
# `db` boots the console against its own PostgreSQL, running in the browser and
# kept in IndexedDB — so a change made while developing is still there after a
# reload, which is what makes the demo worth showing. `demo` assembles the same
# records in memory and keeps nothing, which is the clean slate.
VITE_DATA_SOURCE=db
